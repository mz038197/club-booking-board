# Copy to .env.local for `npm run dev`. On Vercel, set these in Project Settings → Environment Variables.

# Database
#   Local dev without Postgres: PGlite on disk. Run `npm run db:seed` (migrates + demo data)
#   before `npm run dev`; stop the dev server first, PGlite allows one process at a time.
#   Vercel / Supabase: the Supabase pooler connection string (run `npm run db:migrate` against it), e.g.
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=pglite:.pglite

# Router gateway
#   fake = fixed answers from src/server/router-gateway/fake.ts (FAKE_KEYS).
#   Refused when VERCEL_ENV=production, or NODE_ENV=production outside Vercel.
ROUTER_GATEWAY=fake
#   Real gateway (leave ROUTER_GATEWAY unset):
# ROUTER_URL=https://ai.vanscoding.com
# ROUTER_SERVICE_CREDENTIAL=<this app's Service Credential; never commit it>
#   OAuth Client of the teacher admin (router ADR 0094); default club-booking-admin.
#   Register <this app's origin>/auth/callback as its redirect URI in the router.
# ROUTER_OAUTH_CLIENT_ID=club-booking-admin

# Agent Builder (學生專用 OpenAPI at /api/v1/openapi.json + the 課前準備「Agent Builder 設定」card)
#   This app's public origin; OpenAPI servers[0].url = <PUBLIC_BASE_URL>/api/v1.
#   Default: https://$VERCEL_PROJECT_PRODUCTION_URL on Vercel, else the request's origin.
# PUBLIC_BASE_URL=https://club-booking.vercel.app
#   Router origin students' browsers reach for Authorization/Token URL (<url>/oauth/authorize, /oauth/token).
#   Default: ROUTER_URL, else https://ai.vanscoding.com. Override either URL outright if needed.
# ROUTER_PUBLIC_URL=https://ai.vanscoding.com
# AGENT_BUILDER_AUTHORIZATION_URL=https://ai.vanscoding.com/oauth/authorize
# AGENT_BUILDER_TOKEN_URL=https://ai.vanscoding.com/oauth/token
#   OAuth Client registered in the router for Agent Builder (scope classroom). Default agent-builder.
# AGENT_BUILDER_CLIENT_ID=agent-builder
#   vans-mcp-server's OAuth entry (vans ADR 0004). Default below.
# MCP_SERVER_URL=https://mcp.vanscoding.com/mcp-oauth/

# Teacher session cookie (HMAC-SHA256, at least 32 characters). Changing it signs every teacher out.
#   Generate for Vercel: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TEACHER_SESSION_SECRET=dev-only-teacher-session-secret-change-me

# Seed script only (npm run db:seed): which router class gets the demo 目前堂課. Default 56.
# SEED_CLASS_ID=56
