# Copy to .env.local for `npm run dev`. On Vercel, set these in Project Settings → Environment Variables.

# Database
#   Local dev without Postgres: PGlite on disk. Run `npm run db:seed` (migrates + demo data)
#   before `npm run dev`; stop the dev server first, PGlite allows one process at a time.
#   Vercel / Supabase: the Supabase pooler connection string (run `npm run db:migrate` against it), e.g.
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=pglite:.pglite

# Router gateway
#   fake = fixed answers from src/server/router-gateway/fake.ts (FAKE_KEYS).
#   Refused when VERCEL_ENV=production, or NODE_ENV=production outside Vercel.
ROUTER_GATEWAY=fake
#   Real gateway (leave ROUTER_GATEWAY unset):
# ROUTER_URL=https://ai.vanscoding.com
# ROUTER_SERVICE_CREDENTIAL=<this app's Service Credential; never commit it>

# Seed script only (npm run db:seed): which router class gets the demo 目前堂課. Default 56.
# SEED_CLASS_ID=56
